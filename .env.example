SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=viking_db
DB_SSLMODE=disable
UPLOAD_DIR=./uploads
JWT_SECRET=super-secret-viking-key-change-in-production
JWT_EXPIRATION_HOURS=4
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBSCRIBER_EMAIL=mailto:admin@viking-app.zondasolutions.com

# Google Calendar Integration
# GOOGLE_CALENDAR_ID: Your personal Gmail address that shares the calendar with the service account
GOOGLE_CALENDAR_ID=your-personal-email@gmail.com
# GOOGLE_CREDENTIALS_JSON: Run `base64 -w 0 credentials.json` locally and paste the result here
GOOGLE_CREDENTIALS_JSON=base64_encoded_content_of_credentials_json_here
SUBDOMAIN=
FIREBASE_CREDENTIALS_JSON=

# ==============================================================================
# ARCA / AFIP - Facturacion Electronica (Factura C)
# ==============================================================================
# CUIT del contribuyente emisor (11 digitos sin guiones)
AFIP_CUIT=
# Punto de venta asignado para Web Services en ARCA (ej. 2)
AFIP_PUNTO_VENTA=
# Ruta al certificado digital X.509 descargado de ARCA
AFIP_CERT_PATH=./config/certs/<cert>.crt
# Ruta a la clave privada RSA asociada al certificado
AFIP_KEY_PATH=./config/certs/<key>.key
# Entorno de ejecucion: 'production' o 'homologation'
AFIP_ENV=production
# URL del servicio WSAA (Autenticacion y Autorizacion)
AFIP_WSAA_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
# URL del servicio WSFEV1 (Facturacion Electronica)
AFIP_WSFE_URL=https://servicios1.afip.gov.ar/wsfev1/service.asmx